{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kora.dev/schemas/solution-conformance-report-v0alpha1.json",
  "title": "KORA Solution Conformance Report v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "package", "runtime", "status", "summary", "cases", "activity", "timestamps"],
  "properties": {
    "schema_version": {"const": "kora.solution.conformance-report/v0alpha1"},
    "protocol_version": {"const": "kora.dev/v0alpha1"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptor_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
        "descriptor_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "status": {"enum": ["passed", "failed"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status", "run_id", "lifecycle_state", "status_reference", "result_reference", "checks"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "minLength": 3, "maxLength": 128},
          "status": {"enum": ["passed", "failed"]},
          "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
          "lifecycle_state": {"enum": ["succeeded", "failed"]},
          "status_reference": {"type": "string", "pattern": "^runs/[a-f0-9]{32}/status\\.json$"},
          "result_reference": {"type": "string", "pattern": "^runs/[a-f0-9]{32}/result\\.json$"},
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "passed"],
              "properties": {"name": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}}
            }
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_performed", "network_accessed", "model_inference_performed", "gpu_execution_performed"],
      "properties": {
        "execution_performed": {"type": "boolean"},
        "network_accessed": {"const": false},
        "model_inference_performed": {"const": false},
        "gpu_execution_performed": {"const": false}
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
