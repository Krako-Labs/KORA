{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "privacy_state",
    "events",
    "counters",
    "card"
  ],
  "properties": {
    "operation": {
      "const": "research_query"
    },
    "privacy_state": {
      "const": "Local Only"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "deterministic",
          "retrieval_only",
          "hits",
          "model_calls",
          "remote_provider_calls",
          "uploads"
        ],
        "properties": {
          "event": {
            "const": "lexical_retrieval"
          },
          "deterministic": {
            "const": true
          },
          "retrieval_only": {
            "const": true
          },
          "hits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "model_calls": {
            "const": 0
          },
          "remote_provider_calls": {
            "const": 0
          },
          "uploads": {
            "const": 0
          }
        }
      }
    },
    "counters": {
      "$ref": "#/$defs/queryCounters"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "query",
        "result_status",
        "evidence",
        "privacy_state",
        "counters",
        "structural_validation"
      ],
      "properties": {
        "schema_version": {
          "const": "kora.research_evidence_card.v1"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "result_status": {
          "enum": [
            "evidence_found",
            "insufficient_evidence"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "privacy_state": {
          "const": "Local Only"
        },
        "counters": {
          "$ref": "#/$defs/zeroCounters"
        },
        "structural_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "validator_version"
          ],
          "properties": {
            "result": {
              "const": "passed"
            },
            "validator_version": {
              "const": "kora.evidence_card_validator.v1"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "zeroCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "remote_provider_calls",
        "uploads"
      ],
      "properties": {
        "model_calls": {
          "const": 0
        },
        "remote_provider_calls": {
          "const": 0
        },
        "uploads": {
          "const": 0
        }
      }
    },
    "queryCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "retrieval_hits",
        "model_calls",
        "remote_provider_calls",
        "uploads"
      ],
      "properties": {
        "queries": {
          "const": 1
        },
        "retrieval_hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "model_calls": {
          "const": 0
        },
        "remote_provider_calls": {
          "const": 0
        },
        "uploads": {
          "const": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_title",
        "document_id",
        "page",
        "chunk_id",
        "evidence_id",
        "verbatim_retrieved_excerpt",
        "retrieval_rank"
      ],
      "properties": {
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "pattern": "^doc-[A-Za-z0-9.-]+-[a-f0-9]{12}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^doc-[A-Za-z0-9.-]+-[a-f0-9]{12}:p[0-9]{3}:c[0-9]{3}$"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^doc-[A-Za-z0-9.-]+-[a-f0-9]{12}:p[0-9]{3}:c[0-9]{3}$"
        },
        "verbatim_retrieved_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
