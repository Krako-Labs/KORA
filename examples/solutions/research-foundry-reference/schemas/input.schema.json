{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "top_k"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  }
}
